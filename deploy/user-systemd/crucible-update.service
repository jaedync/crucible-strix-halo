# Template. Off until you install it (see "Updates" in the README). Nothing in the repository installs or enables it.
# Replace @CHECKOUT@ with the folder of your clone; the install command in the README does it with sed.
[Unit]
Description=Update Crucible to the newest release (./crucible update --yes)

[Service]
Type=oneshot
WorkingDirectory=@CHECKOUT@
# ./crucible update restarts crucible-server.service by itself when it runs, and rolls back by itself when a step fails.
ExecStart=@CHECKOUT@/crucible update --yes
# The update can build the engine, and that takes a long time. Give the rest of the system the first turn.
Nice=19
# The server and its model share this memory. A build (make, one job) peaked at 1.4 GB in a test, so the cap is about
# three times that. If memory runs out anyway, the kernel stops the build first, and not the server.
# OOMPolicy=continue: systemd does not stop the whole unit then. The update sees that the build failed and
# restores the previous release. Without this line, the update stops with the build and leaves the new source behind.
MemoryMax=4G
OOMScoreAdjust=1000
OOMPolicy=continue
TimeoutStartSec=6h
