Crucible patch 1 of xgrammar v0.2.9 (third_party/README.md): a length-bounded JSON string never holds a raw
control character (U+0000 to U+001F), as the unbounded class. 0.2.9 excluded only CR and LF there, so json.loads
refused the output. Test: tests/constraint_test.cpp (a raw TAB is refused). The build applies this file to the
pinned upstream file with tools/vendor_patch.py (exact context, no offset, no fuzz); the tree keeps the upstream file.

--- a/third_party/xgrammar/cpp/json_schema_converter.cc
+++ b/third_party/xgrammar/cpp/json_schema_converter.cc
@@ -2773,8 +2773,11 @@
     if (!excludes_.empty()) {
       WarnDroppedLengthConstraints(spec, rule_name);
     } else {
-      int32_t character =
-          builder_.AddCharacterClass({{'"', '"'}, {'\\', '\\'}, {'\r', '\r'}, {'\n', '\n'}}, true);
+      // Crucible patch 1: a JSON string never holds a raw control character,
+      // as basic_string_sub. 0.2.9 excluded only CR and LF here, so a length-bounded string took a raw TAB.
+      int32_t character = builder_.AddCharacterClass(
+          {{0, 0x1f}, {'"', '"'}, {'\\', '\\'}, {'\r', '\r'}, {'\n', '\n'}}, true
+      );
       int32_t body = Repeat(rule_name + "_characters", character, spec.min_length, spec.max_length);
       return Sequence({ByteString("\""), body, ByteString("\"")});
     }
